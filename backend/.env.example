# Copy this file to backend/.env and fill in the values.
# Do not commit backend/.env.

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b
GNANI_API_KEY=

# Comma-separated browser origins for the public frontend, for example
# https://namma-hr.vercel.app
# Localhost origins used by Vite are always allowed.
CORS_ORIGINS=
